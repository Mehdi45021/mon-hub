# Config IA — jamais exposée au frontend.
# Mets les clés que tu veux : le serveur essaie les fournisseurs DANS L'ORDRE
# et utilise le PREMIER qui a une clé et qui répond.

# 1) Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 2) OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# 3) Google Gemini (endpoint compatible OpenAI)
GEMINI_API_KEY=
GEMINI_MODEL=

# 4) Groq
GROQ_API_KEY=
GROQ_MODEL=

# 5) Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=

# 6) OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# E-mail (SMTP Gmail avec code d'application)

# ===== SÉCURITÉ (ne jamais committer ce fichier) =====
APP_ENCRYPTION_KEY=
APP_SECRET=
APP_NAME=Mon Hub
APP_DOMAIN=localhost
APP_URL=http://localhost:3001

# ===== SMTP (PHPMailer → Nodemailer) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
